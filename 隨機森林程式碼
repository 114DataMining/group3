# 13. ROC Curve（五折交叉驗證：Train / Test）
# ================================
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_curve, auc
import numpy as np
import matplotlib.pyplot as plt

# ===== 5-fold CV =====
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

mean_fpr = np.linspace(0, 1, 100)

tprs_train, tprs_test = [], []
aucs_train, aucs_test = [], []

for i, (train_idx, test_idx) in enumerate(cv.split(X_train_res, y_train_res), 1):

    X_tr = X_train_res.iloc[train_idx]
    X_te = X_train_res.iloc[test_idx]
    y_tr = y_train_res[train_idx]
    y_te = y_train_res[test_idx]

    # ===== Train model =====
    model.fit(X_tr, y_tr)

    # ===== Train ROC =====
    y_tr_prob = model.predict_proba(X_tr)[:, 1]
    fpr_tr, tpr_tr, _ = roc_curve(y_tr, y_tr_prob)
    auc_tr = auc(fpr_tr, tpr_tr)

    # ===== Test ROC =====
    y_te_prob = model.predict_proba(X_te)[:, 1]
    fpr_te, tpr_te, _ = roc_curve(y_te, y_te_prob)
    auc_te = auc(fpr_te, tpr_te)

    # ===== 每個 fold 畫一張圖 =====
    plt.figure(figsize=(6, 5))
    plt.plot(fpr_tr, tpr_tr, lw=2, label=f'Train ROC (AUC = {auc_tr:.4f})')
    plt.plot(fpr_te, tpr_te, lw=2, label=f'Test ROC (AUC = {auc_te:.4f})')
    plt.plot([0, 1], [0, 1], linestyle='--', color='gray')

    plt.xlabel('False Positive Rate')
    plt.ylabel('True Positive Rate')
    plt.title(f'ROC Curve - Fold {i}')
    plt.legend(loc='lower right')
    plt.grid()
    plt.show()

    # ===== 儲存數值 =====
    tprs_train.append(np.interp(mean_fpr, fpr_tr, tpr_tr))
    tprs_test.append(np.interp(mean_fpr, fpr_te, tpr_te))
    aucs_train.append(auc_tr)
    aucs_test.append(auc_te)

# ====== 存起來算平均 ======
tprs_train.append(np.interp(mean_fpr, fpr_tr, tpr_tr))
tprs_test.append(np.interp(mean_fpr, fpr_te, tpr_te))
aucs_train.append(auc_tr)
aucs_test.append(auc_te)


# ====== 平均 ROC ======
mean_tpr_train = np.mean(tprs_train, axis=0)
mean_tpr_test  = np.mean(tprs_test, axis=0)

mean_tpr_train[-1] = 1.0
mean_tpr_test[-1]  = 1.0

mean_auc_train = np.mean(aucs_train)
std_auc_train  = np.std(aucs_train)

mean_auc_test = np.mean(aucs_test)
std_auc_test  = np.std(aucs_test)


plt.figure(figsize=(7, 6))

plt.plot(
    mean_fpr,
    mean_tpr_train,
    lw=2,
    label=f'Train Mean ROC (AUC = {mean_auc_train:.4f} ± {std_auc_train:.4f})'
)

plt.plot(
    mean_fpr,
    mean_tpr_test,
    lw=2,
    label=f'Test Mean ROC (AUC = {mean_auc_test:.4f} ± {std_auc_test:.4f})'
)

plt.plot([0, 1], [0, 1], linestyle='--', color='gray')

plt.xlabel('False Positive Rate')
plt.ylabel('True Positive Rate')
plt.title('Mean ROC Curve (5-Fold Cross-Validation)')
plt.legend(loc='lower right')
plt.grid()
plt.show()

