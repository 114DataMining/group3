# 12. ROC Curve（五折交叉驗證）
# ================================
from sklearn.metrics import roc_curve, auc
import numpy as np
import matplotlib.pyplot as plt

cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

mean_fpr = np.linspace(0, 1, 100)
tprs = []
aucs = []

plt.figure(figsize=(8, 6))

for i, (train_idx, val_idx) in enumerate(cv.split(X_train_res, y_train_res), 1):
    X_tr  = X_train_res.iloc[train_idx]
    X_val = X_train_res.iloc[val_idx]
    y_tr  = y_train_res[train_idx]
    y_val = y_train_res[val_idx]

    model.fit(X_tr, y_tr)
    y_val_prob = model.predict_proba(X_val)[:, 1]

    fpr, tpr, _ = roc_curve(y_val, y_val_prob)
    roc_auc = auc(fpr, tpr)

    # 畫每一折 ROC
    plt.plot(
        fpr, tpr,
        lw=1, alpha=0.4,
        label=f'Fold {i} ROC (AUC = {roc_auc:.4f})'
    )

    # 插值用來算平均 ROC
    interp_tpr = np.interp(mean_fpr, fpr, tpr)
    interp_tpr[0] = 0.0
    tprs.append(interp_tpr)
    aucs.append(roc_auc)


# ================================
# 平均 ROC + 標準差
# ================================
mean_tpr = np.mean(tprs, axis=0)
mean_tpr[-1] = 1.0
mean_auc = np.mean(aucs)
std_auc = np.std(aucs)

std_tpr = np.std(tprs, axis=0)

plt.plot(
    mean_fpr,
    mean_tpr,
    color='b',
    label=f'Mean ROC (AUC = {mean_auc:.4f} ± {std_auc:.4f})',
    lw=2
)

plt.fill_between(
    mean_fpr,
    mean_tpr - std_tpr,
    mean_tpr + std_tpr,
    color='grey',
    alpha=0.2,
    label='±1 std'
)

# Random guess
plt.plot([0, 1], [0, 1], linestyle='--', color='black', label='Random Guess')

plt.xlabel('False Positive Rate')
plt.ylabel('True Positive Rate')
plt.title('ROC Curve (5-Fold Cross-Validation)')
plt.legend(loc='lower right')
plt.grid()
plt.show()


# ================================
# 數值輸出（老師看數據用）
# ================================
print("五折 AUC：", aucs)
print("平均 AUC：", mean_auc)
print("五次標準差：", std_auc)
print(f"平均 ± 標準差： {mean_auc:.4f} ± {std_auc:.4f}")

