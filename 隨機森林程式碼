    f'Mean Train (5-Fold CV)\nAccuracy={mean_acc_train:.4f}'
)
axes[5, 0].set_xlabel('Predicted')
axes[5, 0].set_ylabel('True')


# ================================
# 平均 Test Confusion Matrix
# ================================
