import pandas as pd
import numpy as np
import pyreadstat
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import (
    confusion_matrix, accuracy_score,
    roc_curve, roc_auc_score,
    classification_report
)

# ===============================
# 2️⃣ 讀取資料
# ===============================
train_df, _ = pyreadstat.read_sav("train_balanced.sav")
test_df, _  = pyreadstat.read_sav("test.sav")

feature_cols = [
    "work_cat","edu_cat","mar_cat","occ_cat","rel_cat",
    "race_cat","sex_cat","nat_cat","edun_cat","age_cat",
    "capital.gain","capital.loss","hours.per.week"
]

X_train = train_df[feature_cols]
y_train = train_df["income_bin"]

X_test  = test_df[feature_cols]
y_test  = test_df["income_bin"]

# ===============================
# 3️⃣ 模型 & CV
# ===============================
model = DecisionTreeClassifier(
    criterion="gini",
    max_depth=4,
    min_samples_leaf=20,
    random_state=42
)
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

# ===============================
# 4️⃣ 儲存容器（五折）
# ===============================
cm_train_list, cm_test_list = [], []
acc_train_list, acc_test_list = [], []

roc_train_list, roc_test_list = [], []
auc_train_list, auc_test_list = [], []

importance_list = []
report_list_train, report_list_test = [], []

# ===============================
# 5️⃣ 五折交叉驗證（每折：Train/Test CM + Train/Test ROC）
# ===============================
for fold, (train_idx, val_idx) in enumerate(cv.split(X_train, y_train), start=1):
    X_tr, X_val = X_train.iloc[train_idx], X_train.iloc[val_idx]
    y_tr, y_val = y_train.iloc[train_idx], y_train.iloc[val_idx]

    model.fit(X_tr, y_tr)

    # ===== 預測：Train / Test
    y_tr_pred   = model.predict(X_tr)
    y_test_pred = model.predict(X_test)

    # ===== Train/Test accuracy（存起來）
    acc_train = accuracy_score(y_tr, y_tr_pred)
    acc_test  = accuracy_score(y_test, y_test_pred)
    acc_train_list.append(acc_train)
    acc_test_list.append(acc_test)

    # ===============================
    # (A) Confusion Matrix（每折：Train + Test 同一張）
    # ===============================
    cm_tr = confusion_matrix(y_tr, y_tr_pred)
    cm_te = confusion_matrix(y_test, y_test_pred)

    cm_train_list.append(cm_tr)
    cm_test_list.append(cm_te)

    plt.figure(figsize=(10,4))

    plt.subplot(1,2,1)
    sns.heatmap(cm_tr, annot=True, fmt="d", cmap="Oranges")
    plt.title(f"Fold {fold} Train CM")
    plt.xlabel("Predicted")
    plt.ylabel("Actual")

    plt.subplot(1,2,2)
    sns.heatmap(cm_te, annot=True, fmt="d", cmap="Blues")
    plt.title(f"Fold {fold} Test CM")
    plt.xlabel("Predicted")
    plt.ylabel("Actual")

    plt.tight_layout()
    plt.show()

    # ===============================
    # (B) ROC（每折：Train + Test 同一張）
    # ===============================
    y_tr_prob   = model.predict_proba(X_tr)[:, 1]
    y_test_prob = model.predict_proba(X_test)[:, 1]

    fpr_tr, tpr_tr, _ = roc_curve(y_tr, y_tr_prob)
    fpr_te, tpr_te, _ = roc_curve(y_test, y_test_prob)

    roc_train_list.append((fpr_tr, tpr_tr))
    roc_test_list.append((fpr_te, tpr_te))

    auc_tr = roc_auc_score(y_tr, y_tr_prob)
    auc_te = roc_auc_score(y_test, y_test_prob)
    auc_train_list.append(auc_tr)
    auc_test_list.append(auc_te)

    plt.figure(figsize=(7,6))
    plt.plot(fpr_tr, tpr_tr, label=f"Train AUC={auc_tr:.3f}")
    plt.plot(fpr_te, tpr_te, label=f"Test  AUC={auc_te:.3f}")
    plt.plot([0,1],[0,1],'--',color='gray')
    plt.title(f"Fold {fold} ROC (Train vs Test)")
    plt.xlabel("FPR")
    plt.ylabel("TPR")
    plt.legend()
    plt.tight_layout()
    plt.show()

    # ===== 特徵重要性（折內存起來做平均±std）
    importance_list.append(model.feature_importances_)

    # ===== 分類報告（Train 用 X_tr，Test 用同一份 X_test）
    report_list_train.append(classification_report(y_tr, y_tr_pred, output_dict=True))
    report_list_test.append(classification_report(y_test, y_test_pred, output_dict=True))

# ===============================
# 6️⃣ 平均混淆矩陣（Train / Test）
# ===============================
cm_train_mean = np.mean(np.array(cm_train_list), axis=0)
cm_test_mean  = np.mean(np.array(cm_test_list), axis=0)

plt.figure(figsize=(10,4))

plt.subplot(1,2,1)
sns.heatmap(cm_train_mean, annot=True, fmt=".1f", cmap="Oranges")
plt.title("Mean Train Confusion Matrix (5-Fold)")
plt.xlabel("Predicted")
plt.ylabel("Actual")

plt.subplot(1,2,2)
sns.heatmap(cm_test_mean, annot=True, fmt=".1f", cmap="Blues")
plt.title("Mean Test Confusion Matrix (5-Fold)")
plt.xlabel("Predicted")
plt.ylabel("Actual")

plt.tight_layout()
plt.show()

# ===============================
# 7️⃣ Mean ROC（Train + Test 同一張，含 AUC 平均±標準差）
# ===============================
mean_fpr = np.linspace(0, 1, 200)

tpr_tr_interp = np.array([np.interp(mean_fpr, fpr, tpr) for fpr, tpr in roc_train_list])
tpr_te_interp = np.array([np.interp(mean_fpr, fpr, tpr) for fpr, tpr in roc_test_list])

mean_tpr_tr = tpr_tr_interp.mean(axis=0)
std_tpr_tr  = tpr_tr_interp.std(axis=0)

mean_tpr_te = tpr_te_interp.mean(axis=0)
std_tpr_te  = tpr_te_interp.std(axis=0)

mean_auc_tr = np.mean(auc_train_list)
std_auc_tr  = np.std(auc_train_list)

mean_auc_te = np.mean(auc_test_list)
std_auc_te  = np.std(auc_test_list)

plt.figure(figsize=(8,6))
plt.plot(mean_fpr, mean_tpr_tr, label=f"Mean Train ROC (AUC={mean_auc_tr:.3f} ± {std_auc_tr:.3f})")
plt.fill_between(mean_fpr, mean_tpr_tr-std_tpr_tr, mean_tpr_tr+std_tpr_tr, alpha=0.2)

plt.plot(mean_fpr, mean_tpr_te, label=f"Mean Test  ROC (AUC={mean_auc_te:.3f} ± {std_auc_te:.3f})")
plt.fill_between(mean_fpr, mean_tpr_te-std_tpr_te, mean_tpr_te+std_tpr_te, alpha=0.2)

plt.plot([0,1],[0,1],'--',color='gray')
plt.xlabel("FPR")
plt.ylabel("TPR")
plt.title("Mean ROC over 5 Folds (Train vs Test)")
plt.legend()
plt.tight_layout()
plt.show()

# ===============================
# 8️⃣ 平均特徵重要性（五折平均 ± 標準差）＋ 圖
# ===============================
importance_arr = np.array(importance_list)
feat_df = pd.DataFrame({
    "feature": feature_cols,
    "mean_importance": importance_arr.mean(axis=0),
    "std_importance": importance_arr.std(axis=0)
}).sort_values("mean_importance", ascending=True)

plt.figure(figsize=(10,6))
plt.barh(
    y=feat_df["feature"],
    width=feat_df["mean_importance"],
    xerr=feat_df["std_importance"].to_numpy(),
    capsize=5
)
plt.xlabel("Mean Feature Importance ± Std")
plt.ylabel("Feature")
plt.title("Feature Importance over 5 folds")
plt.tight_layout()
plt.show()

