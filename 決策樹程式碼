# 9️⃣ 五折分類報告（mean / std / mean±std）— 取 positive 類
# ===============================
def five_fold_classification_stats(reports):
    metrics = ["precision", "recall", "f1-score"]
    sample_keys = reports[0].keys()
    class_keys = [k for k in sample_keys if k not in ["accuracy", "macro avg", "weighted avg"]]
    positive_key = sorted(class_keys)[-1]  # 預設取較大的那類當 positive

    mean_dict, std_dict, mean_std_dict = {}, {}, {}
    for m in metrics:
        values = np.array([r[positive_key][m] for r in reports])
        mean_dict[m] = values.mean()
        std_dict[m]  = values.std()
        mean_std_dict[m] = f"{values.mean():.6f} ± {values.std():.6f}"

    support = np.mean([r[positive_key]["support"] for r in reports])

    mean_df = pd.DataFrame(mean_dict, index=["positive"])
    std_df  = pd.DataFrame(std_dict,  index=["positive"])
    mean_std_df = pd.DataFrame(mean_std_dict, index=["positive"])

    mean_df["support"] = support
    std_df["support"]  = support
    mean_std_df["support"] = support
    return mean_df, std_df, mean_std_df

mean_report, std_report, mean_std_report = five_fold_classification_stats(report_list_test)

# ===============================
# 🔟 平均分類報告（Train / Test）
# ===============================
def average_classification_report(reports):
    keys = list(reports[0].keys())
    avg_report = {}
    for k in keys:
        if k not in ["accuracy", "macro avg", "weighted avg"]:
            avg_report[k] = {
                "precision": np.mean([r[k]["precision"] for r in reports]),
                "recall":    np.mean([r[k]["recall"] for r in reports]),
                "f1-score":  np.mean([r[k]["f1-score"] for r in reports]),
                "support":   np.mean([r[k]["support"] for r in reports]),
            }
    return avg_report

avg_report_train = average_classification_report(report_list_train)
avg_report_test  = average_classification_report(report_list_test)

# ===============================
# 1️⃣1️⃣ 訓練整個訓練集並畫決策樹
